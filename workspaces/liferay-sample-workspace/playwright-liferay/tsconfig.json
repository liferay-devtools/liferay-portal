{
	"compilerOptions": {
		"baseUrl": ".",
		"esModuleInterop": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"noEmit": true,
		"paths": {
			"*": [
				"node_modules/*"
			]
		},
		"skipLibCheck": true,
		"target": "es2020",
		"types": [
			"node"
		]
	},
	"include": [
		"*.ts",
		"../playwright-custom/**/*.ts",
		"core/**/*.ts"
	]
}